# PostgreSQL Database Configuration
POSTGRES_USER=webhooklens
POSTGRES_PASSWORD=webhooklens_secret
POSTGRES_DB=webhooklens
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Mailpit & Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@webhooklens.local
MAILPIT_UI_PORT=8025
APP_BASE_URL=http://localhost:8080

# WebHookLens API Configuration
PORT=8080
DATABASE_URL=postgres://webhooklens:webhooklens_secret@localhost:5432/webhooklens?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-key!
JWT_EXPIRATION_HOURS=24

# Worker Pool & Performance
WORKER_POOL_SIZE=10
WORKER_BUFFER_SIZE=5000
MAX_REQUEST_BODY_MB=5
ENDPOINT_CACHE_TTL_MINUTES=5
